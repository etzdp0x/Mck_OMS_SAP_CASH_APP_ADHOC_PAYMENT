      </m:Wizard>

    </m:content>
    <!--  -->

    <!-- <m:footer>
				<m:Bar>
					<m:contentRight>
						<m:Button id="idBackBtn" text="Back" press="onBackMasterBtn" type="Success"/>
						<m:Button id="idSaveBtn" text="Save" press="onSaveMasterBtn" type="Success"/>
					</m:contentRight>
				</m:Bar>
			</m:footer> -->

  </m:Page>

</mvc:View>